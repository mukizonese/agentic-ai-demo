# Environment
ENVIRONMENT=development
DEBUG=true

# LLM backend selection
USE_OLLAMA=true
USE_OPENAI=false
USE_HF=false

# Vector DB selection
USE_PINECONE_API=false
USE_LOCAL_VECTORDB=true
LOCAL_VECTORDB_TYPE=chroma

# LLM model
OLLAMA_MODEL=gemma:2b
OLLAMA_HOST=host.docker.internal:11434

# OpenAI config (when enabled)
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-3.5-turbo

# HuggingFace config (when enabled)
HF_API_KEY=your-hf-key-here
HF_MODEL=microsoft/DialoGPT-medium

# Pinecone config (when enabled)
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_ENV=us-west1-gcp
PINECONE_INDEX=agentic-demo-index

# ChromaDB config
CHROMA_HOST=chromadb2
CHROMA_PORT=8000

# Service URLs
MCP_SERVER_URL=http://mcp-server:8001
PRODUCT_APP_URL=http://product-app-api:8002
SUPPORT_APP_URL=http://support-app-api:8003

# Langflow Configuration
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=admin123
LANGFLOW_DISABLE_TELEMETRY=true
LANGFLOW_DATABASE_URL=sqlite:///app/langflow.db
LANGFLOW_HOST=0.0.0.0
LANGFLOW_PORT=7860
LANGFLOW_WORKERS=1
LANGFLOW_DEV=false
LANGFLOW_LOG_LEVEL=INFO
LANGFLOW_CACHE_TYPE=disk
LANGFLOW_CACHE_TTL=3600
LANGFLOW_CHROMA_PERSIST_DIRECTORY=/app/chroma_db
# Additional Langflow API Keys (if needed)
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_API_KEY=your-google-key-here
